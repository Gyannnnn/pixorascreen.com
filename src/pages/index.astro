---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import { landingJsonLd } from '../data/seo';
import { t } from '../i18n/ui';
---

<BaseLayout
  title={t('en', 'home.meta_title')}
  description={t('en', 'home.meta_description')}
  canonicalPath="/"
  locale="en"
  pageKey={{ kind: 'home' }}
  jsonLd={landingJsonLd('en')}
>
  <HomePage locale="en" />
</BaseLayout>
       