---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { popularTools } from '../data/tools';
import { type Locale } from '../data/locales';

const locale: Locale = 'en';
---

<BaseLayout
  title="Page Not Found (404) • PixoraScreen"
  description="The page you are looking for does not exist on PixoraScreen. Explore our full suite of fullscreen display tools."
  canonicalPath="/404/"
  lang="en"
  locale={locale}
>
  <section class="site-shell py-16 md:py-24">
    <div class="relative overflow-hidden rounded-3xl border border-hairline bg-canvas p-8 md:p-14 shadow-soft">
      {/* Decorative background ambient glows */}
      <div class="pointer-events-none absolute -right-24 -top-24 size-96 rounded-full bg-cyan-brand/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 size-96 rounded-full bg-violet-brand/10 blur-3xl"></div>

      <div class="relative z-10 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-soft px-3.5 py-1.5 text-xs font-mono text-muted">
            <span class="size-2 rounded-full bg-pink-brand animate-pulse"></span>
            ERROR 404 • PAGE NOT FOUND
          </div>
          
          <h1 class="mt-5 text-4xl font-semibold leading-[0.95] text-balance text-ink md:text-6xl">
            Lost in the pixels.
          </h1>
          
          <p class="mt-5 text-lg leading-8 text-body max-w-xl">
            The page you're looking for doesn't exist, has been moved, or the web address was mistyped.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-canvas transition-all hover:bg-body hover:scale-[1.02] active:scale-[0.98]"
              href="/"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Return to Home
            </a>
            
            <a
              class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-6 py-3.5 text-sm font-medium text-ink transition-all hover:bg-canvas-soft hover:scale-[1.02] active:scale-[0.98]"
              href="/#colors"
            >
              Explore Utilities
            </a>
          </div>
        </div>

        {/* Visual 404 Digital Glitch Card */}
        <div class="relative flex aspect-video w-full flex-col items-center justify-center overflow-hidden rounded-2xl border border-hairline bg-canvas-soft-2 p-6 text-center select-none shadow-inner">
          <div class="absolute inset-0 bg-[radial-gradient(#ebebeb_1px,transparent_1px)] [background-size:16px_16px] opacity-30 dark:bg-[radial-gradient(#2a2a2a_1px,transparent_1px)]"></div>
          
          {/* Animated CRT scanlines */}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-cyan-brand/5 to-transparent bg-[length:100%_4px] opacity-60"></div>
          
          <div class="relative z-10 flex flex-col items-center">
            <span class="font-mono text-7xl md:text-8xl font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-pink-brand via-violet-brand to-cyan-brand drop-shadow-sm">
              404
            </span>
            <div class="mt-3 flex items-center gap-2 font-mono text-xs text-muted">
              <span class="inline-block size-2 rounded-full bg-red-500"></span>
              <span>SIGNAL NO LONGER DETECTED</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular tools Section -->
  <section class="border-t border-hairline bg-canvas py-16">
    <div class="site-shell">
      <div class="max-w-xl">
        <p class="font-mono text-xs text-muted">RECOMMENDED TOOLS</p>
        <h2 class="mt-3 text-3xl font-semibold text-balance text-ink">Popular Fullscreen Utilities</h2>
        <p class="mt-2 text-sm leading-6 text-body">
          Select one of our popular screen tools to test your display, create ambient atmospheres, or run interactive screens:
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {popularTools.slice(0, 4).map((tool) => (
          <ToolCard tool={tool} locale={locale} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
