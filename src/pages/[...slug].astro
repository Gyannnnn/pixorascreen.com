---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import RelatedTools from '../components/RelatedTools.astro';
import ScreenTool from '../components/ScreenTool.astro';
import HackerTyper from '../components/HackerTyper.astro';
import BlueScreen from '../components/BlueScreen.astro';
import BrokenScreen from '../components/BrokenScreen.astro';
import WindowsUpdate from '../components/WindowsUpdate.astro';
import MacOSUpdate from '../components/MacOSUpdate.astro';
import UbuntuScreen from '../components/UbuntuScreen.astro';
import AndroidUpdate from '../components/AndroidUpdate.astro';
import RadarScreen from '../components/RadarScreen.astro';
import FakeVirusScreen from '../components/FakeVirusScreen.astro';
import WhiteNoiseScreen from '../components/WhiteNoiseScreen.astro';
import WindowsXpCrash from '../components/WindowsXpCrash.astro';
import FireplaceScreen from '../components/FireplaceScreen.astro';
import SnowScreen from '../components/SnowScreen.astro';
import RainScreen from '../components/RainScreen.astro';
import MatrixScreen from '../components/MatrixScreen.astro';
import ClockScreen from '../components/ClockScreen.astro';
import StarsScreen from '../components/StarsScreen.astro';
import GalaxyScreen from '../components/GalaxyScreen.astro';
// import StarsScreen from '../components/StarsScreen';
import AmbientScreen from '../components/AmbientScreen.astro';
import AquariumScreen from '../components/AquariumScreen.astro';
import DeadPixelTest from '../components/DeadPixelTest.astro';
import DvdScreensaver from '../components/DvdScreensaver.astro';
import OledBurnInTest from '../components/OledBurnInTest.astro';
import CountdownTimer from '../components/CountdownTimer.astro';
import FakeVideoCall from '../components/FakeVideoCall.astro';
import ShareTool from '../components/ShareTool.astro';
import { localeOrder, locales, type Locale } from '../data/locales';
import { getRelatedTools, tools, type Tool } from '../data/tools';
import { categoryLabel, t, toolName } from '../i18n/ui';
import { homePath, staticPagePath } from '../i18n/paths';
import { allToolPaths, landingJsonLd, siteAuthor, toolJsonLd, toolPath } from '../data/seo';
import { toolText } from '../i18n/content';

type PageProps =
  | { kind: 'home'; locale: Locale; path: string }
  | { kind: 'tool'; locale: Locale; path: string; tool: Tool };

export function getStaticPaths() {
  const homePaths = localeOrder
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { slug: locale }, props: { kind: 'home', locale, path: `${locales[locale].pathPrefix}/` } }));

  const toolPaths = allToolPaths().map(({ tool, locale, path }) => ({
    params: { slug: path.replace(/^\/|\/$/g, '') },
    props: { kind: 'tool', locale, path, tool },
  }));

  return [...homePaths, ...toolPaths];
}

const props = Astro.props as PageProps;
const text = props.kind === 'tool' ? toolText(props.tool, props.locale) : null;
// Byline: "By {author} · Updated {date}" in the page language, with the author linked to the about page.
const byline = text?.updated
  ? t(props.locale, 'tool.byline', {
      date: new Intl.DateTimeFormat(locales[props.locale].lang, { dateStyle: 'long', timeZone: 'UTC' }).format(text.updated),
    }).split('{author}')
  : null;
---

{props.kind === 'home' ? (
  <BaseLayout
    title={t(props.locale, 'home.meta_title')}
    description={t(props.locale, 'home.meta_description')}
    canonicalPath={props.path}
    jsonLd={landingJsonLd(props.locale)}
    locale={props.locale}
    pageKey={{ kind: 'home' }}
  >
    <HomePage locale={props.locale} />
  </BaseLayout>
) : (
  <BaseLayout
    title={text!.title}
    description={text!.description}
    canonicalPath={toolPath(props.tool, props.locale)}
    pageKey={{ kind: 'tool', id: props.tool.id }}
    jsonLd={toolJsonLd(props.tool, props.path, props.locale, text!)}
    locale={props.locale}
  >
    <section class="site-shell py-10 md:py-16">
      <nav class="text-sm text-body" aria-label={t(props.locale, 'tool.breadcrumb_label')}>
        <a class="hover:text-ink" href={homePath(props.locale)}>{t(props.locale, 'tool.breadcrumb_home')}</a>
        <span class="mx-2">/</span>
        <span>{text!.breadcrumb}</span>
      </nav>
      <div class={`mt-8 grid gap-8 lg:items-center min-w-0 ${props.tool.kind === 'color' || props.tool.kind === 'test' ? 'lg:grid-cols-[1.05fr_0.95fr]' : 'lg:grid-cols-[0.8fr_1.2fr]'}`}>
        <div class="min-w-0">
          <p class="font-mono text-xs text-muted">{categoryLabel(props.locale, props.tool.category)}</p>
          <h1 class="mt-4 text-5xl font-semibold leading-[0.95] text-balance text-ink md:text-6xl">{text!.h1}</h1>
          <p class="mt-5 text-lg leading-8 text-body">{text!.lede}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {text!.chips.map((control) => <span class="rounded-full border border-hairline bg-canvas px-3 py-1 text-xs text-body">{control}</span>)}
          </div>
        </div>
        <div class="min-w-0">
          {props.tool.slug === 'fake-video-call' ? (
            <FakeVideoCall tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'countdown-timer' ? (
            <CountdownTimer tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'oled-burn-in-test' ? (
            <OledBurnInTest tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'dvd-screensaver' ? (
            <DvdScreensaver tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'dead-pixel-test' ? (
            <DeadPixelTest tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'blue-screen-prank' ? (
            <BlueScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'broken-screen' ? (
            <BrokenScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'hacker-typer' ? (
            <HackerTyper tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'windows-update' ? (
            <WindowsUpdate tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'macos-screen' ? (
            <MacOSUpdate tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'ubuntu-screen' ? (
            <UbuntuScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'android-update' ? (
            <AndroidUpdate tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'radar-screen' ? (
            <RadarScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'fake-virus-screen' ? (
            <FakeVirusScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'white-noise-screen' ? (
            <WhiteNoiseScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'windows-xp-crash' ? (
            <WindowsXpCrash tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'fireplace-screen' ? (
            <FireplaceScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'snow-screen' ? (
            <SnowScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'rain-screen' ? (
            <RainScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'matrix-screen' ? (
            <MatrixScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'stars-screen' ? (
            <StarsScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'galaxy-screen' ? (
            <GalaxyScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'clock-screen' ? (
            <ClockScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'ambient-screen' ? (
            <AmbientScreen tool={props.tool} locale={props.locale} />
          ) : props.tool.slug === 'aquarium-screen' ? (
            <AquariumScreen tool={props.tool} locale={props.locale} />
          ) : (
            <ScreenTool tool={props.tool} locale={props.locale} />
          )}
        </div>
      </div>
    </section>

    <ShareTool tool={props.tool} locale={props.locale} />

    <section class="border-y border-hairline bg-canvas">
      <div class="site-shell grid gap-6 py-12 md:grid-cols-3">
        <div>
          <p class="font-mono text-xs text-muted">{t(props.locale, 'tool.shortcuts')}</p>
          <h2 class="mt-3 text-2xl font-semibold text-balance text-ink">{t(props.locale, 'tool.shortcuts_heading')}</h2>
        </div>
        <div class="grid gap-3 text-sm text-body md:col-span-2 sm:grid-cols-3">
          {text!.shortcuts.map((shortcut) => (
            <p><kbd class="rounded border border-hairline px-2 py-1 font-mono">{shortcut.keys}</kbd> {shortcut.label}</p>
          ))}
        </div>
      </div>
    </section>

    <RelatedTools tools={getRelatedTools(props.tool)} locale={props.locale} />

    <section class="site-shell max-w-3xl py-10">
      <p class="font-mono text-xs text-muted">{t(props.locale, 'tool.faq')}</p>
      <h2 class="mt-3 text-3xl font-semibold text-balance text-ink">{t(props.locale, 'tool.faq_heading', { name: toolName(props.locale, props.tool) })}</h2>
      <div class="mt-6 divide-y divide-hairline rounded-lg border border-hairline bg-canvas">
        {text!.faqs.map((faq) => (
          <details class="group p-5">
            <summary class="list-none cursor-pointer text-base font-medium text-ink">{faq.question}</summary>
            <p class="mt-3 text-sm leading-6 text-body">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <article class="site-shell rich-article max-w-3xl py-16">
      {byline && (
        <p class="article-meta">{byline[0]}<a href={staticPagePath('about', props.locale)}>{siteAuthor.name}</a>{byline[1]}</p>
      )}
      <Fragment set:html={text!.articleHtml} />
    </article>
  </BaseLayout>
)}
