---
import type { Tool } from '../data/tools';
import type { Locale } from '../data/locales';
import ReactAquariumScreen from './AquariumScreen.tsx';
import { getToolAssets } from '../utils/assets';
import ToolFallback from './ToolFallback.astro';

type Props = {
  tool: Tool;
  locale: Locale;
};

const { tool, locale } = Astro.props;
const { audioFiles: aquariumAudioFiles } = getToolAssets('aquarium-screen');
---

<ReactAquariumScreen 
  tool={tool} 
  locale={locale} 
  aquariumAudioFiles={aquariumAudioFiles}
  client:only="react" 
>
  <ToolFallback slot="fallback" tool={tool} locale={locale} />
</ReactAquariumScreen>

<style>
  /* Custom scrollbars inside settings controls drawer */
  :global(.custom-scrollbar::-webkit-scrollbar) {
    width: 6px;
    height: 6px;
  }
  :global(.custom-scrollbar::-webkit-scrollbar-track) {
    background: transparent;
  }
  :global(.custom-scrollbar::-webkit-scrollbar-thumb) {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 999px;
  }
  :global(.custom-scrollbar::-webkit-scrollbar-thumb:hover) {
    background: rgba(255, 255, 255, 0.35);
  }

  /* Fade-in animation overlays */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  :global(.animate-fadeIn) {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
