---
import type { Tool } from '../data/tools';
import type { Locale } from '../data/locales';
import ReactSnowScreen from './SnowScreen.tsx';
import { getToolAssets } from '../utils/assets';

type Props = { tool: Tool; locale: Locale };
const { tool, locale } = Astro.props;

const { backgrounds, audioFiles } = getToolAssets('snow-screen');
---

<ReactSnowScreen 
  tool={tool} 
  locale={locale} 
  backgrounds={backgrounds} 
  audioFiles={audioFiles} 
  client:only="react" 
/>

<style>
  /* Responsive custom vignette overlay */
  .bg-radial-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 35%, rgba(0, 0, 0, 0.45) 100%);
    z-index: 6;
  }

  /* Dual Range Slider Thumb CSS overrides */
  :global(.slider-thumb-pointer) {
    pointer-events: none;
  }

  :global(.slider-thumb-pointer::-webkit-slider-thumb) {
    pointer-events: auto !important;
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #ffffff !important;
    border: 2px solid #38bdf8 !important;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.5), 0 2px 4px rgba(0, 0, 0, 0.3) !important;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s, background-color 0.15s;
  }

  :global(.slider-thumb-pointer::-webkit-slider-thumb:hover) {
    transform: scale(1.25);
    background: #38bdf8 !important;
    border-color: #ffffff !important;
  }

  :global(.slider-thumb-pointer::-moz-range-thumb) {
    pointer-events: auto !important;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #ffffff !important;
    border: 2px solid #38bdf8 !important;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.5), 0 2px 4px rgba(0, 0, 0, 0.3) !important;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s, background-color 0.15s;
  }

  :global(.slider-thumb-pointer::-moz-range-thumb:hover) {
    transform: scale(1.25);
    background: #38bdf8 !important;
    border-color: #ffffff !important;
  }

  /* Fade-in Animation for secondary control elements */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.animate-fadeIn) {
    animation: fadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Disable transition effects on size properties during fullscreen transitions */
  :global(.snow-container) {
    transition: none !important;
  }

  :global(.snow-container:fullscreen) {
    width: 100vw !important;
    height: 100vh !important;
    margin: 0 !important;
    max-width: none !important;
    max-height: none !important;
    border-radius: 0 !important;
    border: none !important;
  }

  /* Scroll lock styling on body when fullscreen is active */
  :global(html.is-snow-fullscreen) {
    overflow: hidden !important;
  }
  :global(html.is-snow-fullscreen body) {
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
  }
</style>
