---
// The contact page in any locale: every string comes from the "contact" UI namespace.
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/locales';
import { locales } from '../../i18n/locales';
import { absoluteUrl, siteUrl, staticPagePath } from '../../i18n/paths';
import { siteName } from '../../data/seo';
import { strings, t } from '../../i18n/ui';

type Props = { locale: Locale };
const { locale } = Astro.props;
const [responseBefore, responseAfter] = t(locale, 'contact.response_body').split('{time}');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: t(locale, 'contact.meta_title'),
  description: t(locale, 'contact.meta_description'),
  url: absoluteUrl(staticPagePath('contact', locale)),
  inLanguage: locales[locale].lang,
  isPartOf: { '@type': 'WebSite', name: siteName, url: siteUrl },
};
---

<BaseLayout
  title={t(locale, 'contact.meta_title')}
  description={t(locale, 'contact.meta_description')}
  canonicalPath={staticPagePath('contact', locale)}
  locale={locale}
  pageKey={{ kind: 'page', id: 'contact' }}
  jsonLd={jsonLd}
>
  <section class="site-shell py-16 md:py-24">
    <div class="max-w-3xl">
      <p class="font-mono text-xs text-muted uppercase tracking-wider">{t(locale, 'contact.eyebrow')}</p>
      <h1 class="mt-4 text-5xl font-semibold leading-[0.95] text-balance text-ink md:text-6xl">{t(locale, 'contact.heading')}</h1>
      <p class="mt-6 text-lg leading-8 text-body text-balance">
        {t(locale, 'contact.intro')}
      </p>
    </div>
  </section>

  <section class="border-y border-hairline bg-canvas">
    <div class="site-shell py-12 md:py-16">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.5fr] lg:gap-16">
        <!-- Sidebar context -->
        <div class="space-y-8">
          <div>
            <h2 class="font-mono text-xs text-muted uppercase tracking-wider">{t(locale, 'contact.direct_heading')}</h2>
            <p class="mt-3 text-sm leading-6 text-body">
              {t(locale, 'contact.direct_body')}
            </p>
            <p class="mt-2">
              <a href="mailto:hi.gyanaranjanpatra@gmail.com" class="text-sm font-medium text-ink hover:text-link underline underline-offset-4 transition-colors">
                hi.gyanaranjanpatra@gmail.com
              </a>
            </p>
          </div>

          <div>
            <h2 class="font-mono text-xs text-muted uppercase tracking-wider">{t(locale, 'contact.response_heading')}</h2>
            <p class="mt-3 text-sm leading-6 text-body">
              {responseBefore}<strong>{t(locale, 'contact.response_time')}</strong>{responseAfter}
            </p>
          </div>

          <div>
            <h2 class="font-mono text-xs text-muted uppercase tracking-wider">{t(locale, 'contact.bugs_heading')}</h2>
            <p class="mt-3 text-sm leading-6 text-body">
              {t(locale, 'contact.bugs_body')}
            </p>
            <ul class="mt-2 list-disc pl-5 text-sm leading-6 text-body space-y-1">
              <li>{t(locale, 'contact.bugs_device')}</li>
              <li>{t(locale, 'contact.bugs_browser')}</li>
              <li>{t(locale, 'contact.bugs_resolution')}</li>
            </ul>
          </div>
        </div>

        <!-- Form box -->
        <div class="relative rounded-xl border border-hairline bg-canvas-soft p-6 md:p-8 shadow-soft">
          <!-- Form State -->
          <div id="form-container">
            <!-- Error Banner -->
            <div id="error-container" class="hidden mb-6 rounded-lg bg-red-50 dark:bg-red-950/40 p-4 border border-red-200 dark:border-red-900/50 text-red-700 dark:text-red-300 text-sm">
            </div>

            <form id="contact-form" class="space-y-6" data-i18n={JSON.stringify(strings(locale, 'contact'))}>
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="contact-name" class="block font-mono text-xs text-muted uppercase tracking-wider mb-2">
                    {t(locale, 'contact.name_label')}
                  </label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    placeholder={t(locale, 'contact.name_placeholder')}
                    class="w-full h-10 px-3 bg-canvas text-ink border border-hairline rounded-md focus:outline-none focus:ring-2 focus:ring-ink focus:border-transparent transition-all placeholder:text-muted/50 text-sm"
                  />
                </div>
                <div>
                  <label for="contact-email" class="block font-mono text-xs text-muted uppercase tracking-wider mb-2">
                    {t(locale, 'contact.email_label')}
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder={t(locale, 'contact.email_placeholder')}
                    class="w-full h-10 px-3 bg-canvas text-ink border border-hairline rounded-md focus:outline-none focus:ring-2 focus:ring-ink focus:border-transparent transition-all placeholder:text-muted/50 text-sm"
                  />
                </div>
              </div>

              <div>
                <label for="contact-subject" class="block font-mono text-xs text-muted uppercase tracking-wider mb-2">
                  {t(locale, 'contact.subject_label')}
                </label>
                <input
                  type="text"
                  id="contact-subject"
                  name="subject"
                  required
                  placeholder={t(locale, 'contact.subject_placeholder')}
                  class="w-full h-10 px-3 bg-canvas text-ink border border-hairline rounded-md focus:outline-none focus:ring-2 focus:ring-ink focus:border-transparent transition-all placeholder:text-muted/50 text-sm"
                />
              </div>

              <div>
                <label for="contact-message" class="block font-mono text-xs text-muted uppercase tracking-wider mb-2">
                  {t(locale, 'contact.message_label')}
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="6"
                  placeholder={t(locale, 'contact.message_placeholder')}
                  class="w-full p-3 bg-canvas text-ink border border-hairline rounded-md focus:outline-none focus:ring-2 focus:ring-ink focus:border-transparent transition-all placeholder:text-muted/50 text-sm resize-y"
                ></textarea>
              </div>

              <div class="flex items-center justify-end">
                <button
                  type="submit"
                  id="submit-btn"
                  class="inline-flex items-center justify-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-canvas hover:bg-body disabled:opacity-50 disabled:cursor-not-allowed transition-all cursor-pointer"
                >
                  <span class="btn-text">{t(locale, 'contact.send')}</span>
                  <svg
                    class="btn-spinner hidden size-4 animate-spin text-canvas"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </button>
              </div>
            </form>
          </div>

          <!-- Success Modal State (Hidden Initially) -->
          <div id="success-container" class="hidden py-8 text-center space-y-6">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-950/30 dark:text-emerald-400">
              <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
              </svg>
            </div>
            
            <div class="space-y-2">
              <h3 class="text-2xl font-semibold text-ink">{t(locale, 'contact.success_heading')}</h3>
              <p class="mx-auto max-w-md text-sm text-body leading-relaxed">
                {t(locale, 'contact.success_body')}
              </p>
            </div>

            <div class="pt-4">
              <button
                type="button"
                id="reset-btn"
                class="inline-flex rounded-full border border-hairline bg-canvas px-4 py-2.5 text-xs font-medium text-ink hover:bg-canvas-soft transition-colors cursor-pointer"
              >
                {t(locale, 'contact.send_another')}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successContainer = document.getElementById('success-container');
    const formContainer = document.getElementById('form-container');
    const errorContainer = document.getElementById('error-container');
    const submitButton = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const resetButton = document.getElementById('reset-btn') as HTMLButtonElement | null;

    // Localized strings for this page, rendered into the form by the server.
    const text: Record<string, string> = JSON.parse(form?.dataset.i18n ?? '{}');

    if (form && successContainer && formContainer && submitButton) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (errorContainer) {
          errorContainer.classList.add('hidden');
          errorContainer.textContent = '';
        }

        const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
        const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
        const subjectInput = document.getElementById('contact-subject') as HTMLInputElement | null;
        const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement | null;

        const payload = {
          name: nameInput?.value?.trim() || '',
          email: emailInput?.value?.trim() || '',
          subject: subjectInput?.value?.trim() || '',
          message: messageInput?.value?.trim() || '',
        };

        // Toggle Loading State
        const btnText = submitButton.querySelector('.btn-text');
        const btnSpinner = submitButton.querySelector('.btn-spinner');
        if (btnText) btnText.textContent = text.sending;
        if (btnSpinner) btnSpinner.classList.remove('hidden');
        submitButton.disabled = true;

        // Disable all form elements after extracting values
        const inputs = form.querySelectorAll('input, textarea');
        inputs.forEach((input) => input.setAttribute('disabled', 'true'));

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();

          if (!res.ok || data.error) {
            throw new Error(text.error_send);
          }

          formContainer.style.opacity = '0';
          formContainer.style.transition = 'opacity 0.2s ease-out';
          
          setTimeout(() => {
            formContainer.classList.add('hidden');
            successContainer.classList.remove('hidden');
            form.reset();
            inputs.forEach((input) => input.removeAttribute('disabled'));
            if (btnText) btnText.textContent = text.send;
            if (btnSpinner) btnSpinner.classList.add('hidden');
            submitButton.disabled = false;
            formContainer.style.opacity = '';
          }, 200);
        } catch (err) {
          if (errorContainer) {
            errorContainer.textContent = err instanceof Error && err.message ? err.message : text.error_generic;
            errorContainer.classList.remove('hidden');
          }
          inputs.forEach((input) => input.removeAttribute('disabled'));
          if (btnText) btnText.textContent = text.send;
          if (btnSpinner) btnSpinner.classList.add('hidden');
          submitButton.disabled = false;
        }
      });
    }

    if (resetButton && formContainer && successContainer) {
      resetButton.addEventListener('click', () => {
        successContainer.classList.add('hidden');
        formContainer.classList.remove('hidden');
        if (errorContainer) {
          errorContainer.classList.add('hidden');
          errorContainer.textContent = '';
        }
      });
    }
  });
</script>
