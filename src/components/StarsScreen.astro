---
export const ssr = false;
export const prerender = false;
import type { Tool } from '../data/tools';
import type { Locale } from '../data/locales';
import ReactStarsScreen from './StarsScreen.tsx';
import ToolFallback from './ToolFallback.astro';
import { strings } from '../i18n/ui';

const { tool, locale } = Astro.props;
---

<ReactStarsScreen locale={locale} strings={strings(locale, 'stars')} client:only="react">
  <ToolFallback slot="fallback" tool={tool} locale={locale} />
</ReactStarsScreen>
