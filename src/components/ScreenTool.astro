                </button>
                <button class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-hairline bg-canvas px-2.5 sm:px-3 text-xs font-medium text-body hover:bg-canvas-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition-colors cursor-pointer" type="button" data-favorite>
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {t(locale, 'screen.favorite')}
                </button>
                <div class="inline-flex h-8 items-center rounded-lg border border-hairline bg-canvas p-0.5 shadow-xs focus-within:ring-2 focus-within:ring-ink focus-within:ring-offset-2 transition-shadow max-w-full">
                  <select class="h-full border-0 bg-transparent py-0 pl-1.5 sm:pl-2 pr-1 text-xs text-body hover:text-ink focus:ring-0 focus:outline-hidden cursor-pointer font-medium max-w-[110px] sm:max-w-none" data-download-orientation aria-label="Select screen orientation for download">
                    <option value="landscape">{t(locale, 'screen.orientation_landscape')}</option>
                    <option value="portrait">{t(locale, 'screen.orientation_portrait')}</option>
                    <option value="square">{t(locale, 'screen.orientation_square')}</option>
                    <option value="device">{t(locale, 'screen.orientation_device')}</option>
                  </select>
                  <div class="h-4 w-px bg-hairline/80"></div>
                  <button class="inline-flex h-full items-center gap-1 sm:gap-1.5 rounded-md px-2 sm:px-3 text-xs font-medium text-body hover:bg-canvas-soft hover:text-ink transition-colors cursor-pointer" type="button" data-download>
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    {t(locale, 'screen.download')}
                  </button>
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-2 md:justify-end">
                <button class="inline-flex h-7 items-center gap-1 rounded-md border border-hairline/50 bg-canvas/40 px-2 sm:px-2.5 text-xs font-medium text-muted hover:bg-canvas-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition-colors cursor-pointer" type="button" data-copy-hex>
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  {t(locale, 'screen.copy_hex')}
                </button>
                <button class="inline-flex h-7 items-center gap-1 rounded-md border border-hairline/50 bg-canvas/40 px-2 sm:px-2.5 text-xs font-medium text-muted hover:bg-canvas-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition-colors cursor-pointer" type="button" data-copy-rgb>
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  {t(locale, 'screen.copy_rgb')}
                </button>
                <span aria-live="polite" data-status class="text-xs text-muted"></span>
                <div class="flex flex-wrap gap-1.5 max-w-full" data-favorites aria-label={t(locale, 'screen.favorites')}></div>
              </div>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2 px-3 py-2.5 sm:px-4 md:px-5">
          <button class="inline-flex h-7 items-center gap-1 rounded-md px-2 sm:px-2.5 text-xs font-medium text-muted hover:bg-canvas-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition-colors" type="button" data-copy-hex>
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            {t(locale, 'screen.copy_hex')}
          </button>
          <button class="inline-flex h-7 items-center gap-1 rounded-md px-2 sm:px-2.5 text-xs font-medium text-muted hover:bg-canvas-soft hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink transition-colors" type="button" data-copy-rgb>
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            {t(locale, 'screen.copy_rgb')}
          </button>
          <span aria-live="polite" data-status class="sm:ml-auto text-xs text-muted"></span>
          <div class="flex flex-wrap gap-1.5 max-w-full" data-favorites aria-label={t(locale, 'screen.favorites')}></div>
        </div>
        {mode === 'rgb' && (
          <div class="flex flex-wrap items-center gap-1.5 border-t border-hairline/60 px-3 py-2.5 sm:px-4 md:px-5 bg-canvas-soft/40">
            <span class="text-xs font-mono font-medium text-muted mr-1 shrink-0">{t(locale, 'screen.subpixel_tests')}</span>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:border-red-500/50 hover:text-red-500 transition-colors cursor-pointer" type="button" data-rgb-preset="#ff0000" title="Pure Red Subpixel Test (Press R)">
              <span class="size-2.5 rounded-full bg-[#ff0000]"></span> {t(locale, 'screen.pure_red')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:border-green-500/50 hover:text-green-500 transition-colors cursor-pointer" type="button" data-rgb-preset="#00ff00" title="Pure Green Subpixel Test (Press G)">
              <span class="size-2.5 rounded-full bg-[#00ff00]"></span> {t(locale, 'screen.pure_green')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:border-blue-500/50 hover:text-blue-500 transition-colors cursor-pointer" type="button" data-rgb-preset="#0000ff" title="Pure Blue Subpixel Test (Press B)">
              <span class="size-2.5 rounded-full bg-[#0000ff]"></span> {t(locale, 'screen.pure_blue')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:bg-canvas-soft transition-colors cursor-pointer" type="button" data-rgb-preset="#ffffff" title="White Subpixel Test (Press W)">
              <span class="size-2.5 rounded-full bg-white border border-gray-400"></span> {t(locale, 'screen.white')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:bg-canvas-soft transition-colors cursor-pointer" type="button" data-rgb-preset="#000000" title="Black Subpixel Test (Press K)">
              <span class="size-2.5 rounded-full bg-black border border-gray-600"></span> {t(locale, 'screen.black')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:bg-canvas-soft transition-colors cursor-pointer sm:ml-auto" type="button" data-rgb-split title="Reset to 3-Channel Split View">
              <span class="flex size-3 overflow-hidden rounded-full border border-hairline"><span class="w-1/3 bg-red-500"></span><span class="w-1/3 bg-green-500"></span><span class="w-1/3 bg-blue-500"></span></span> {t(locale, 'screen.rgb_split')}
            </button>
          </div>
        )}
        {mode === 'hex' && (
          <div class="flex flex-wrap items-center gap-1.5 border-t border-hairline/60 px-3 py-2.5 sm:px-4 md:px-5 bg-canvas-soft/40">
            <span class="text-xs font-mono font-medium text-muted mr-1 shrink-0">{t(locale, 'screen.hex_presets')}</span>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:bg-canvas-soft transition-colors cursor-pointer" type="button" data-hex-preset="#000000" title="OLED Black (#000000)">
              <span class="size-2.5 rounded-full bg-black border border-gray-600"></span> {t(locale, 'screen.oled_black')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:bg-canvas-soft transition-colors cursor-pointer" type="button" data-hex-preset="#121212" title="Dark Mode Grey (#121212)">
              <span class="size-2.5 rounded-full bg-[#121212] border border-gray-600"></span> {t(locale, 'screen.dark_mode')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:border-blue-500/50 hover:text-blue-500 transition-colors cursor-pointer" type="button" data-hex-preset="#0070f3" title="Brand Blue (#0070F3)">
              <span class="size-2.5 rounded-full bg-[#0070f3]"></span> #0070F3
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:bg-canvas-soft transition-colors cursor-pointer" type="button" data-hex-preset="#ffffff" title="Pure White (#FFFFFF)">
              <span class="size-2.5 rounded-full bg-white border border-gray-400"></span> {t(locale, 'screen.white')}
            </button>
            <button class="inline-flex h-7 items-center gap-1.5 rounded-md border border-hairline bg-canvas px-2 sm:px-2.5 text-xs font-medium text-body hover:bg-canvas-soft transition-colors cursor-pointer sm:ml-auto" type="button" data-hex-palette-reset title="Reset to 4-Color Palette Split">
              <span class="flex size-3 overflow-hidden rounded-full border border-hairline"><span class="w-1/4 bg-[#171717]"></span><span class="w-1/4 bg-[#7c3aed]"></span><span class="w-1/4 bg-[#ff0080]"></span><span class="w-1/4 bg-[#f9cb28]"></span></span> {t(locale, 'screen.palette_reset')}
            </button>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  function normalizeHex(value: string) {
    const trimmed = value.trim();
    if (/^#[0-9a-f]{6}$/i.test(trimmed)) return trimmed.toLowerCase();
    if (/^[0-9a-f]{6}$/i.test(trimmed)) return `#${trimmed.toLowerCase()}`;
    return null;
  }

  function hexToRgb(hex: string) {
    const clean = hex.replace('#', '');
    const number = Number.parseInt(clean, 16);
    return `${(number >> 16) & 255}, ${(number >> 8) & 255}, ${number & 255}`;
  }

  function hexToHsl(hex: string) {
    const [r, g, b] = hexToRgb(hex).split(', ').map((value) => Number(value) / 255);
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    let h = 0;
    let s = 0;
    const l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
      if (max === g) h = (b - r) / d + 2;
      if (max === b) h = (r - g) / d + 4;
      h /= 6;
    }
    return `hsl(${Math.round(h * 360)}, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%)`;
  }

  function hslToHex(value: string) {
    const match = value.match(/hsl\(?\s*(\d{1,3})[,\s]+(\d{1,3})%?[,\s]+(\d{1,3})%?\s*\)?/i);
    if (!match) return null;
    const h = Number(match[1]) / 360;
    const s = Number(match[2]) / 100;
    const l = Number(match[3]) / 100;
    const hue = (p: number, q: number, t: number) => {
      let next = t;
      if (next < 0) next += 1;
      if (next > 1) next -= 1;
      if (next < 1 / 6) return p + (q - p) * 6 * next;
      if (next < 1 / 2) return q;
      if (next < 2 / 3) return p + (q - p) * (2 / 3 - next) * 6;
      return p;
    };
    const q = l < 0.5 ? l * (1 + s) : l + s - l * s;
    const p = 2 * l - q;
    const rgb = s === 0 ? [l, l, l] : [hue(p, q, h + 1 / 3), hue(p, q, h), hue(p, q, h - 1 / 3)];
    return `#${rgb.map((channel) => Math.round(channel * 255).toString(16).padStart(2, '0')).join('')}`;
  }

  function rgbToHex(value: string) {
    const match = value.match(/(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})/);
    if (!match) return null;
    const [r, g, b] = [Number(match[1]), Number(match[2]), Number(match[3])];
    if (r > 255 || g > 255 || b > 255) return null;
    return `#${[r, g, b].map((c) => c.toString(16).padStart(2, '0')).join('')}`;
  }

  function randomHex() {
    return `#${Math.floor(Math.random() * 0xffffff).toString(16).padStart(6, '0')}`;
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-screen-tool]')) {
    const str = (key: string) => root.dataset[key] ?? '';
    const hexInput = root.querySelector<HTMLInputElement>('[data-hex-input]');
    const rgbInput = root.querySelector<HTMLInputElement>('[data-rgb-input]');
    const hslInput = root.querySelector<HTMLInputElement>('[data-hsl-input]');
    const brightness = root.querySelector<HTMLInputElement>('[data-brightness]');
    const dimmer = root.querySelector<HTMLElement>('[data-dimmer]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const favorites = root.querySelector<HTMLElement>('[data-favorites]');
    const controlsBar = root.querySelector<HTMLElement>('[data-controls-bar]');

    const mode = root.dataset.mode || 'solid';
    let colors = JSON.parse(root.dataset.initialColors || '[]');
    let activeIndex = 0;

    const setStatus = (message: string) => {
      if (!status) return;
      status.textContent = message;
      window.setTimeout(() => {
        status.textContent = '';
      }, 1600);
    };

    const updateBackground = () => {
      if (mode === 'gradient') {
        root.style.background = `linear-gradient(135deg, ${colors[0]}, ${colors[1]})`;
      } else if (mode === 'rgb') {
        root.style.background = `linear-gradient(90deg, ${colors[0]} 0%, ${colors[0]} 33.3%, ${colors[1]} 33.3%, ${colors[1]} 66.6%, ${colors[2]} 66.6%, ${colors[2]} 100%)`;
      } else if (mode === 'hex') {
        root.style.background = `linear-gradient(90deg, ${colors[0]} 0%, ${colors[0]} 25%, ${colors[1]} 25%, ${colors[1]} 50%, ${colors[2]} 50%, ${colors[2]} 75%, ${colors[3]} 75%, ${colors[3]} 100%)`;
      } else {
        root.style.background = colors[0];
      }
    };

    const updateInputs = () => {
      const activeColor = colors[activeIndex];
      if (hexInput) hexInput.value = activeColor;
      if (rgbInput) rgbInput.value = hexToRgb(activeColor);
      if (hslInput) hslInput.value = hexToHsl(activeColor);
    };

    const setColors = (newColors: string[]) => {
      colors = newColors;
      const swatches = root.querySelectorAll<HTMLElement>('.swatch-item');
      colors.forEach((col: string, idx: number) => {
        const swatchVisual = swatches[idx]?.querySelector<HTMLElement>('[data-swatch-item-visual]');
        const pickerInput = swatches[idx]?.querySelector<HTMLInputElement>('[data-color-picker-item]');
        if (swatchVisual) swatchVisual.style.background = col;
        if (pickerInput) pickerInput.value = col;
      });
      updateBackground();
      updateInputs();
    };

    const selectSwatch = (index: number) => {
      activeIndex = index;
      const swatches = root.querySelectorAll<HTMLElement>('.swatch-item');
      swatches.forEach((swatch, idx) => {
        if (idx === index) {
          swatch.classList.add('ring-2', 'ring-ink', 'ring-offset-2', 'scale-105');
          swatch.classList.remove('hover:scale-105');
        } else {
          swatch.classList.remove('ring-2', 'ring-ink', 'ring-offset-2', 'scale-105');
          swatch.classList.add('hover:scale-105');
        }
      });
      updateInputs();
    };

    // Swatches Event Listeners
    const swatches = root.querySelectorAll<HTMLElement>('.swatch-item');
    swatches.forEach((swatch, idx) => {
      const pickerInput = swatch.querySelector<HTMLInputElement>('[data-color-picker-item]');
      pickerInput?.addEventListener('input', () => {
        const newColors = [...colors];
        newColors[idx] = pickerInput.value;
        setColors(newColors);
        selectSwatch(idx);
      });
      swatch.addEventListener('click', (e) => {
        if (e.target !== pickerInput) {
          selectSwatch(idx);
        }
      });
    });

    hexInput?.addEventListener('change', () => {
      const hex = normalizeHex(hexInput.value);
      if (hex) {
        const newColors = [...colors];
        newColors[activeIndex] = hex;
        setColors(newColors);
      }
    });
    hslInput?.addEventListener('change', () => {
      const hex = hslToHex(hslInput.value);
      if (hex) {
        const newColors = [...colors];
        newColors[activeIndex] = hex;
        setColors(newColors);
      }
    });
    rgbInput?.addEventListener('change', () => {
      const hex = rgbToHex(rgbInput.value);
      if (hex) {
        const newColors = [...colors];
        newColors[activeIndex] = hex;
        setColors(newColors);
      }
    });

    brightness?.addEventListener('input', () => {
      if (!dimmer) return;
      const value = Number(brightness.value);
      dimmer.style.background = value < 100 ? `rgb(0 0 0 / ${(100 - value) / 100})` : 'transparent';
      root.style.filter = value > 100 ? `brightness(${value}%)` : '';
    });

    const doFullscreen = () => root.requestFullscreen?.();
    for (const btn of root.querySelectorAll<HTMLElement>('[data-fullscreen], [data-fullscreen-icon]')) {
      btn.addEventListener('click', doFullscreen);
    }
    root.querySelector('[data-copy-hex]')?.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(hexInput?.value ?? '');
      setStatus(str('strHexCopied'));
    });
    root.querySelector('[data-copy-rgb]')?.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(rgbInput?.value ?? '');
      setStatus(str('strRgbCopied'));
    });

    const triggerRandom = () => {
      if (mode === 'gradient') {
        const c1 = randomHex();
        const c2 = randomHex();
        setColors([c1, c2]);
      } else if (mode === 'rgb') {
        const r = `#${Math.floor(100 + Math.random() * 156).toString(16).padStart(2, '0')}0000`;
        const g = `#00${Math.floor(100 + Math.random() * 156).toString(16).padStart(2, '0')}00`;
        const b = `#0000${Math.floor(100 + Math.random() * 156).toString(16).padStart(2, '0')}`;
        setColors([r, g, b]);
      } else if (mode === 'hex') {
        const c1 = randomHex();
        const c2 = randomHex();
        const c3 = randomHex();
        const c4 = randomHex();
        setColors([c1, c2, c3, c4]);
      } else {
        setColors([randomHex()]);
      }
    };

    root.querySelector('[data-random]')?.addEventListener('click', triggerRandom);

    const triggerDownload = () => {
      const orientationSelect = root.querySelector<HTMLSelectElement>('[data-download-orientation]');
      if (!orientationSelect) return;
      const orientation = orientationSelect.value;

      let width = 1920;
      let height = 1080;

      if (orientation === 'portrait') {
        width = 1080;
        height = 1920;
      } else if (orientation === 'square') {
        width = 1080;
        height = 1080;
      } else if (orientation === 'device') {
        width = window.screen.width || window.innerWidth;
        height = window.screen.height || window.innerHeight;
      }

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      if (mode === 'gradient') {
        const grad = ctx.createLinearGradient(0, 0, width, height);
        grad.addColorStop(0, colors[0]);
        grad.addColorStop(1, colors[1]);
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, width, height);
      } else if (mode === 'rgb') {
        const band1 = Math.round(width * 0.3333);
        const band2 = Math.round(width * 0.6666);
        ctx.fillStyle = colors[0];
        ctx.fillRect(0, 0, band1, height);
        ctx.fillStyle = colors[1];
        ctx.fillRect(band1, 0, band2 - band1, height);
        ctx.fillStyle = colors[2];
        ctx.fillRect(band2, 0, width - band2, height);
      } else if (mode === 'hex') {
        const band1 = Math.round(width * 0.25);
        const band2 = Math.round(width * 0.5);
        const band3 = Math.round(width * 0.75);
        ctx.fillStyle = colors[0];
        ctx.fillRect(0, 0, band1, height);
        ctx.fillStyle = colors[1];
        ctx.fillRect(band1, 0, band2 - band1, height);
        ctx.fillStyle = colors[2];
        ctx.fillRect(band2, 0, band3 - band2, height);
        ctx.fillStyle = colors[3];
        ctx.fillRect(band3, 0, width - band3, height);
      } else {
        ctx.fillStyle = colors[0];
        ctx.fillRect(0, 0, width, height);
      }

      const toolId = root.dataset.toolId || 'color-screen';
      const cleanCol = (c: string) => c.replace('#', '');
      let colorPart = '';
      if (mode === 'solid') {
        colorPart = cleanCol(colors[0]);
      } else {
        colorPart = `${mode}-${colors.map(cleanCol).join('-')}`;
      }
      const filename = `${toolId}-${colorPart}-${width}x${height}.png`;

      const link = document.createElement('a');
      link.download = filename;
      link.href = canvas.toDataURL('image/png');
      link.click();
    };

    root.querySelector('[data-download]')?.addEventListener('click', triggerDownload);

    // RGB Preset Button Listeners
    for (const btn of root.querySelectorAll<HTMLElement>('[data-rgb-preset]')) {
      btn.addEventListener('click', () => {
        const targetColor = btn.dataset.rgbPreset;
        if (targetColor) {
          setColors([targetColor, targetColor, targetColor]);
        }
      });
    }

    root.querySelector('[data-rgb-split]')?.addEventListener('click', () => {
      setColors(['#ff0000', '#00ff00', '#0000ff']);
    });

    // HEX Preset Button Listeners
    for (const btn of root.querySelectorAll<HTMLElement>('[data-hex-preset]')) {
      btn.addEventListener('click', () => {
        const targetColor = btn.dataset.hexPreset;
        if (targetColor) {
          setColors([targetColor, targetColor, targetColor, targetColor]);
        }
      });
    }

    root.querySelector('[data-hex-palette-reset]')?.addEventListener('click', () => {
      setColors(['#171717', '#7c3aed', '#ff0080', '#f9cb28']);
    });

    document.addEventListener('fullscreenchange', () => {
      const isActive = document.fullscreenElement === root;
      root.classList.toggle('is-fullscreen', isActive);
      if (controlsBar) controlsBar.style.display = isActive ? 'none' : '';
      for (const btn of root.querySelectorAll<HTMLElement>('[data-fullscreen], [data-fullscreen-icon]')) {
        btn.style.display = isActive ? 'none' : '';
      }
    });

    document.addEventListener('keydown', async (event) => {
      if (
        event.target instanceof HTMLInputElement ||
        event.target instanceof HTMLSelectElement ||
        event.target instanceof HTMLTextAreaElement
      ) return;
      const key = event.key.toLowerCase();
      if (key === 'f') root.requestFullscreen?.();
      if (mode === 'rgb') {
        if (key === 'r') setColors(['#ff0000', '#ff0000', '#ff0000']);
        else if (key === 'g') setColors(['#00ff00', '#00ff00', '#00ff00']);
        else if (key === 'b') setColors(['#0000ff', '#0000ff', '#0000ff']);
        else if (key === 'w') setColors(['#ffffff', '#ffffff', '#ffffff']);
        else if (key === 'k') setColors(['#000000', '#000000', '#000000']);
        else if (key === 's') setColors(['#ff0000', '#00ff00', '#0000ff']);
      } else if (key === 'r') {
        triggerRandom();
      }
      if (key === 'c') {
        await navigator.clipboard?.writeText(hexInput?.value ?? '');
        setStatus(str('strColorCopied'));
      }
      if (key === 'd') {
        triggerDownload();
      }
    });

    const storageKey = 'freescreen-favorites';

    const loadFavorites = () => {
      if (!favorites) return;
      const stored = window.localStorage.getItem(storageKey);
      if (!stored) return;
      const hexes: string[] = JSON.parse(stored);
      for (const hex of hexes) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'size-5 rounded-full border border-hairline ring-1 ring-inset ring-white/20 hover:ring-2 transition-shadow';
        button.style.background = hex;
        button.setAttribute('aria-label', `${str('strRemoveFav')} ${hex}`);
        button.addEventListener('click', () => {
          button.remove();
          const remaining = [...favorites.querySelectorAll('button')].map((b) => b.style.background);
          window.localStorage.setItem(storageKey, JSON.stringify(remaining));
          setStatus(str('strFavRm'));
        });
        favorites.append(button);
      }
    };

    const saveFavorites = (hex: string) => {
      const stored = window.localStorage.getItem(storageKey);
      const hexes: string[] = stored ? JSON.parse(stored) : [];
      if (!hexes.includes(hex)) {
        hexes.push(hex);
        window.localStorage.setItem(storageKey, JSON.stringify(hexes));
      }
    };

    loadFavorites();

    root.querySelector('[data-favorite]')?.addEventListener('click', () => {
      const hex = normalizeHex(hexInput?.value ?? '');
      if (!hex || !favorites) return;
      if ([...favorites.querySelectorAll('button')].some((b) => b.style.background === hex)) {
        setStatus(str('strAlready'));
        return;
      }
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'size-5 rounded-full border border-hairline ring-1 ring-inset ring-white/20 hover:ring-2 transition-shadow';
      button.style.background = hex;
      button.setAttribute('aria-label', `${str('strRemoveFav')} ${hex}`);
      button.addEventListener('click', () => {
        button.remove();
        const remaining = [...favorites.querySelectorAll('button')].map((b) => b.style.background);
        window.localStorage.setItem(storageKey, JSON.stringify(remaining));
        setStatus(str('strFavRm'));
      });
      favorites.append(button);
      saveFavorites(hex);
      setStatus(str('strFavAdd'));
    });
  }
</script>
