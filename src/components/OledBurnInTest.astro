---
import type { Tool } from '../data/tools';
import { type Locale } from '../data/locales';

type Props = {
  tool: Tool;
  locale: Locale;
};

// Static Check fills. The greys come first because an even mid-tone is where faint
// ghosting separates from the background; the primaries follow because a worn
// sub-pixel channel shows up against its own color before it shows against white.
const fills = [
  { id: 'grey-20', label: '20% Grey', color: '#333333' },
  { id: 'grey-50', label: '50% Grey', color: '#808080' },
  { id: 'grey-75', label: '75% Grey', color: '#bfbfbf' },
  { id: 'white', label: 'White', color: '#ffffff' },
  { id: 'red', label: 'Red', color: '#ff0000' },
  { id: 'green', label: 'Green', color: '#00ff00' },
  { id: 'blue', label: 'Blue', color: '#0000ff' },
  { id: 'black', label: 'Black', color: '#000000' },
];
---

<section class="rounded-lg border border-hairline bg-canvas shadow-soft" aria-label="OLED burn-in test">
  <div
    class="group relative grid min-h-[605px] overflow-hidden rounded-md border border-hairline sm:min-h-[504px] lg:min-h-[400px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    style={`background:${fills[1].color};`}
    tabindex="0"
    data-burn-in
    data-fills={JSON.stringify(fills)}
  >
    <!-- Moving Pattern draws here; hidden while Static Check is active so the fill
         below stays perfectly flat, which is what makes faint ghosting visible. -->
    <canvas class="absolute inset-0 size-full hidden" data-pattern aria-hidden="true"></canvas>

    <div class="pointer-events-none absolute inset-0 bg-black/0" data-dimmer></div>

    <button
      class="absolute right-3 top-3 z-20 grid size-11 place-items-center rounded-lg bg-black/25 text-white/90 shadow-xs ring-1 ring-white/15 backdrop-blur-xs transition-all hover:bg-black/45 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      type="button"
      data-fullscreen-icon
      aria-label="Enter fullscreen"
    >
      <svg class="size-6.25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 3H5a2 2 0 0 0-2 2v3" />
        <path d="M21 8V5a2 2 0 0 0-2-2h-3" />
        <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
        <path d="M3 16v3a2 2 0 0 0 2 2h3" />
      </svg>
    </button>

    <div class="relative z-10 mt-auto bg-canvas/85 backdrop-blur-md" data-controls-bar>
      <div class="divide-y divide-hairline/50">
        <div class="p-3.5 sm:p-4 md:p-5">
          <!-- Mode switch. The two modes do opposite jobs, so the note below spells
               out which one you are in rather than leaving it to be inferred. -->
          <div class="flex flex-wrap items-center gap-3">
            <div class="inline-flex rounded-lg border border-hairline p-0.5" role="group" aria-label="Test mode">
              <button
                class="rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
                type="button"
                data-mode-btn="static"
                aria-pressed="true"
              >
                Static Check
              </button>
              <button
                class="rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
                type="button"
                data-mode-btn="moving"
                aria-pressed="false"
              >
                Moving Pattern
              </button>
            </div>
            <p class="min-w-0 flex-1 text-xs leading-5 text-body" data-mode-note aria-live="polite"></p>
          </div>

          <div class="mt-3 grid gap-3 min-w-0">
            <div class="min-w-0" data-fill-group>
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-xs text-muted">Test fill</span>
                {fills.map((fill, index) => (
                  <button
                    class="flex items-center gap-1.5 rounded-full border border-hairline py-0.5 pl-0.5 pr-2.5 text-xs font-medium text-ink transition-all hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
                    type="button"
                    data-fill={index}
                    aria-label={`Fill the screen with ${fill.label.toLowerCase()}`}
                  >
                    <span class="size-4 shrink-0 rounded-full border border-hairline" style={`background:${fill.color};`}></span>
                    {fill.label}
                  </button>
                ))}
              </div>
            </div>

            <div class="grid min-w-0 gap-3 sm:grid-cols-2">
              <label class="block">
                <span class="flex items-center justify-between text-xs text-muted">
                  <span>Brightness</span>
                  <span class="font-mono text-ink" data-brightness-value>100%</span>
                </span>
                <input
                  class="mt-2 w-full cursor-pointer accent-current"
                  type="range"
                  min="20"
                  max="100"
                  step="5"
                  value="100"
                  data-brightness
                  aria-label="Brightness"
                />
              </label>

              <div class="hidden" data-pattern-group>
                <label class="block">
                  <span class="flex items-center justify-between text-xs text-muted">
                    <span>Pattern speed</span>
                    <span class="font-mono text-ink" data-speed-value>1.0x</span>
                  </span>
                  <input
                    class="mt-2 w-full cursor-pointer accent-current"
                    type="range"
                    min="0.2"
                    max="3"
                    step="0.1"
                    value="1"
                    data-speed
                    aria-label="Pattern speed"
                  />
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Fill = { id: string; label: string; color: string };

  const NOTES: Record<string, string> = {
    static:
      'Checking for burn-in. Hold each fill for a few seconds in a dim room and look for faint shadows or patches that stay put as you change color.',
    moving:
      'Helping prevent burn-in. Nothing here stays still, so no pixel holds one value long enough to age unevenly. Leave it running while the screen is idle.',
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-burn-in]')) {
    const fills: Fill[] = JSON.parse(root.dataset.fills || '[]');
    if (fills.length === 0) continue;

    const canvas = root.querySelector<HTMLCanvasElement>('[data-pattern]');
    const dimmer = root.querySelector<HTMLElement>('[data-dimmer]');
    const note = root.querySelector<HTMLElement>('[data-mode-note]');
    const controlsBar = root.querySelector<HTMLElement>('[data-controls-bar]');
    const fillGroup = root.querySelector<HTMLElement>('[data-fill-group]');
    const patternGroup = root.querySelector<HTMLElement>('[data-pattern-group]');
    const brightness = root.querySelector<HTMLInputElement>('[data-brightness]');
    const brightnessValue = root.querySelector<HTMLElement>('[data-brightness-value]');
    const speed = root.querySelector<HTMLInputElement>('[data-speed]');
    const speedValue = root.querySelector<HTMLElement>('[data-speed-value]');
    const fillButtons = Array.from(root.querySelectorAll<HTMLElement>('[data-fill]'));
    const modeButtons = Array.from(root.querySelectorAll<HTMLElement>('[data-mode-btn]'));

    let mode: 'static' | 'moving' = 'static';
    let fillIndex = 1;
    let animId: number | undefined;

    const ACTIVE = ['bg-ink', 'text-canvas'];
    const IDLE = ['text-body'];

    const renderFills = () => {
      for (const [i, button] of fillButtons.entries()) {
        const on = i === fillIndex && mode === 'static';
        button.setAttribute('aria-current', on ? 'true' : 'false');
        button.classList.toggle('ring-2', on);
        button.classList.toggle('ring-ink', on);
      }
    };

    const renderMode = () => {
      for (const button of modeButtons) {
        const on = button.dataset.modeBtn === mode;
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        button.classList.toggle(ACTIVE[0], on);
        button.classList.toggle(ACTIVE[1], on);
        button.classList.toggle(IDLE[0], !on);
      }
      if (note) note.textContent = NOTES[mode];
      fillGroup?.classList.toggle('hidden', mode !== 'static');
      patternGroup?.classList.toggle('hidden', mode !== 'moving');
      canvas?.classList.toggle('hidden', mode !== 'moving');
      if (mode === 'static') {
        stopPattern();
        root.style.background = fills[fillIndex].color;
      } else {
        // A near-black base keeps average brightness low while the pattern moves,
        // since the point of this mode is to rest the panel rather than drive it.
        root.style.background = '#000000';
        startPattern();
      }
      renderFills();
    };

    const resize = () => {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = root.clientWidth || 800;
      const h = root.clientHeight || 480;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      const ctx = canvas.getContext('2d');
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    let t = 0;
    const drawPattern = () => {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const w = root.clientWidth || 800;
      const h = root.clientHeight || 480;

      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#000000';
      ctx.fillRect(0, 0, w, h);

      const rate = Number(speed?.value ?? 1);
      t += rate * 0.35;

      // A drifting grid plus a slow sweep. Both axes move at different rates so the
      // pattern does not repeat its exact position for a long time, which is what
      // stops any single pixel from sitting at one value.
      const cell = 64;
      const offX = (t * 0.8) % cell;
      const offY = (t * 0.55) % cell;
      ctx.strokeStyle = 'rgba(255,255,255,0.22)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (let x = -cell + offX; x < w + cell; x += cell) {
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
      }
      for (let y = -cell + offY; y < h + cell; y += cell) {
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
      }
      ctx.stroke();

      const sweep = ((t * 1.6) % (w + 320)) - 160;
      const grad = ctx.createLinearGradient(sweep - 160, 0, sweep + 160, 0);
      grad.addColorStop(0, 'rgba(255,255,255,0)');
      grad.addColorStop(0.5, 'rgba(255,255,255,0.30)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = grad;
      ctx.fillRect(sweep - 160, 0, 320, h);

      const hue = (t * 0.6) % 360;
      ctx.fillStyle = `hsl(${hue} 70% 55% / 0.85)`;
      const bx = (w - 90) / 2 + Math.cos(t * 0.02) * ((w - 90) / 2);
      const by = (h - 90) / 2 + Math.sin(t * 0.031) * ((h - 90) / 2);
      ctx.fillRect(bx, by, 90, 90);

      animId = requestAnimationFrame(drawPattern);
    };

    function startPattern() {
      if (animId !== undefined) return;
      resize();
      animId = requestAnimationFrame(drawPattern);
    }
    function stopPattern() {
      if (animId !== undefined) cancelAnimationFrame(animId);
      animId = undefined;
    }

    for (const [i, button] of fillButtons.entries()) {
      button.addEventListener('click', () => {
        fillIndex = i;
        if (mode !== 'static') {
          mode = 'static';
          renderMode();
        } else {
          root.style.background = fills[fillIndex].color;
          renderFills();
        }
      });
    }

    for (const button of modeButtons) {
      button.addEventListener('click', () => {
        mode = button.dataset.modeBtn === 'moving' ? 'moving' : 'static';
        renderMode();
      });
    }

    brightness?.addEventListener('input', () => {
      const value = Number(brightness.value);
      if (brightnessValue) brightnessValue.textContent = `${value}%`;
      if (dimmer) dimmer.style.background = value < 100 ? `rgb(0 0 0 / ${(100 - value) / 100})` : 'transparent';
    });

    speed?.addEventListener('input', () => {
      if (speedValue) speedValue.textContent = `${Number(speed.value).toFixed(1)}x`;
    });

    const doFullscreen = () => {
      try {
        const p = root.requestFullscreen?.({ navigationUI: 'hide' } as any);
        if (p && typeof p.catch === 'function') p.catch(() => root.requestFullscreen?.());
      } catch (_) {
        root.requestFullscreen?.();
      }
    };
    for (const button of root.querySelectorAll<HTMLElement>('[data-fullscreen], [data-fullscreen-icon]')) {
      button.addEventListener('click', doFullscreen);
    }

    document.addEventListener('fullscreenchange', () => {
      const isActive = document.fullscreenElement === root;
      root.classList.toggle('is-fullscreen', isActive);
      if (controlsBar) controlsBar.style.display = isActive ? 'none' : '';
      for (const button of root.querySelectorAll<HTMLElement>('[data-fullscreen], [data-fullscreen-icon]')) {
        button.style.display = isActive ? 'none' : '';
      }
      resize();
    });

    window.addEventListener('resize', () => {
      if (mode === 'moving') resize();
    });

    document.addEventListener('keydown', (event) => {
      if (
        event.target instanceof HTMLInputElement ||
        event.target instanceof HTMLSelectElement ||
        event.target instanceof HTMLTextAreaElement
      ) return;

      const key = event.key;
      if (key === 'f' || key === 'F') {
        doFullscreen();
        return;
      }

      // Like the other test screens, the stepping keys only apply once the tool owns
      // the interaction, so they do not take over scrolling for the article below.
      const owns = document.fullscreenElement === root || root.contains(document.activeElement);
      if (!owns) return;

      if (key === 'm' || key === 'M') {
        mode = mode === 'static' ? 'moving' : 'static';
        renderMode();
      } else if (mode === 'static' && (key === 'ArrowRight' || key === 'ArrowDown')) {
        event.preventDefault();
        fillIndex = (fillIndex + 1) % fills.length;
        root.style.background = fills[fillIndex].color;
        renderFills();
      } else if (mode === 'static' && (key === 'ArrowLeft' || key === 'ArrowUp')) {
        event.preventDefault();
        fillIndex = (fillIndex - 1 + fills.length) % fills.length;
        root.style.background = fills[fillIndex].color;
        renderFills();
      }
    });

    renderMode();
  }
</script>
