---
import { categories, tools, type ToolCategoryId } from '../data/tools';
import { type Locale } from '../data/locales';
import { siteName } from '../data/seo';
import { categoryName, t, toolName, toolShortName } from '../i18n/ui';
import { homePath, toolPath } from '../i18n/paths';
import type { languageOptions } from '../i18n/indexing';
import BrandLogo from './BrandLogo.astro';

type Props = {
  locale?: Locale;
  /** Languages this page is available in (current + complete translations). The switcher hides when there is only one. */
  languages?: ReturnType<typeof languageOptions>;
};

const { locale = 'en', languages = [] } = Astro.props;
const categoryIds = Object.keys(categories) as ToolCategoryId[];

// Search matches the localized names and, as aliases, the English ones.
const searchData = tools.map((tool) => ({
  href: toolPath(tool, locale),
  label: toolShortName(locale, tool),
  terms: [toolShortName(locale, tool), toolName(locale, tool), toolShortName('en', tool), toolName('en', tool), tool.slug].join(' ').toLowerCase(),
  category: categoryName(locale, tool.category),
}));
const home = homePath(locale);
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/90 backdrop-blur">
  <div class="site-shell flex h-16 items-center justify-between gap-2 lg:gap-4">
    <div class="flex items-center gap-4 lg:gap-6">
      <a href={home} class="flex shrink-0 items-center whitespace-nowrap" aria-label={t(locale, 'common.home_label', { site: siteName })}>
        <BrandLogo size="md" />
      </a>

      <nav class="hidden items-center lg:flex" aria-label={t(locale, 'nav.primary')}>
        <div class="hidden items-center gap-1 xl:flex">
          {categoryIds.map((categoryId) => (
            <a class="rounded-full px-3 py-2 text-sm text-body hover:bg-canvas-soft-2 hover:text-ink whitespace-nowrap" href={`${home}#${categoryId}`}>
              {categoryName(locale, categoryId)}
            </a>
          ))}
        </div>
      </nav>
    </div>

    <div class="hidden items-center gap-1.5 lg:flex">
      <div class="relative">
        <label class="sr-only" for="site-search">{t(locale, 'nav.search')}</label>
        <input
          id="site-search"
          name="site-search"
          type="search"
          placeholder={t(locale, 'nav.search')}
          autocomplete="off"
          class="h-9 w-32 rounded-md border border-hairline bg-canvas px-3 text-sm text-ink placeholder:text-muted lg:w-40 xl:w-52"
          data-tool-search
        />
      </div>
      {languages.length > 1 && (
        <select class="h-9 rounded-md border border-hairline bg-canvas px-2 text-sm text-body" aria-label={t(locale, 'nav.language')} name="language" data-language-select>
          {languages.map((language) => <option value={language.href} data-locale={language.locale} lang={language.lang} selected={language.current}>{language.label}</option>)}
        </select>
      )}
      <button class="grid size-9 shrink-0 place-items-center rounded-full border border-hairline text-sm text-body hover:text-ink" type="button" aria-label={t(locale, 'nav.theme')} data-theme-toggle>
        <svg class="hidden size-5 [[data-theme=dark]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="size-5 fill-current [[data-theme=dark]_&]:hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>
    </div>

    <div class="flex items-center gap-1.5 lg:hidden">
      <button class="grid size-9 shrink-0 place-items-center rounded-full border border-hairline text-sm text-body hover:text-ink" type="button" aria-label={t(locale, 'nav.theme')} data-theme-toggle>
        <svg class="hidden size-5 [[data-theme=dark]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="size-5 fill-current [[data-theme=dark]_&]:hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>
      <button class="grid size-9 shrink-0 place-items-center rounded-md border border-hairline text-ink hover:text-body" type="button" aria-label={t(locale, 'nav.open_menu')} data-mobile-menu-toggle>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <template data-mobile-menu>
    <div class="fixed inset-0 z-50 flex" data-mobile-menu-overlay>
      <div class="absolute inset-0 bg-black/40" data-mobile-menu-backdrop></div>
      <div class="relative ml-auto flex h-full w-full max-w-sm flex-col bg-canvas shadow-soft">
        <div class="flex items-center justify-between border-b border-hairline px-4 py-4">
          <span class="text-sm font-medium text-ink">{t(locale, 'nav.menu')}</span>
          <button class="grid size-8 place-items-center rounded-md text-body hover:text-ink" type="button" aria-label={t(locale, 'nav.close_menu')} data-mobile-menu-close>
            <svg class="size-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="flex-1 overflow-y-auto px-4 py-4">
          <div class="relative mb-4">
            <label class="sr-only" for="drawer-search">{t(locale, 'nav.search_tools')}</label>
            <input id="drawer-search" name="drawer-search" type="search" placeholder={t(locale, 'nav.search_tools')} autocomplete="off" class="h-10 w-full rounded-md border border-hairline px-3 text-sm" data-tool-search />
          </div>
          {languages.length > 1 && (
            <div class="border-b border-hairline pb-4 mb-4">
              <select class="h-9 w-full rounded-md border border-hairline bg-canvas px-2 text-sm text-body" aria-label={t(locale, 'nav.language')} name="language" data-language-select>
                {languages.map((language) => <option value={language.href} data-locale={language.locale} lang={language.lang} selected={language.current}>{language.label}</option>)}
              </select>
            </div>
          )}
          {categoryIds.map((categoryId) => (
            <div class="border-b border-hairline py-3">
              <p class="mb-2 font-mono text-xs text-muted">{categoryName(locale, categoryId)}</p>
              <div class="grid grid-cols-2 gap-1">
                {tools.filter((tool) => tool.category === categoryId).map((tool) => (
                  <a class="rounded-md px-2 py-2 text-sm text-body hover:bg-canvas-soft hover:text-ink whitespace-nowrap" href={toolPath(tool, locale)}>{toolShortName(locale, tool)}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </template>
</header>

<div hidden data-search-data={JSON.stringify(searchData)}></div>
<script>
  type SearchItem = { href: string; label: string; terms: string; category: string };

  const searchDataElement = document.querySelector<HTMLElement>('[data-search-data]');
  const toolsData: SearchItem[] = JSON.parse(searchDataElement?.dataset.searchData ?? '[]');

  function createSearchDropdown(input: HTMLInputElement) {
    const parent = input.parentElement!;
    parent.querySelector('[data-search-results]')?.remove();
    const dropdown = document.createElement('div');
    dropdown.dataset.searchResults = '';
    dropdown.className = 'absolute left-0 right-0 top-full z-50 mt-1 overflow-hidden rounded-lg border border-hairline bg-canvas shadow-soft';
    parent.appendChild(dropdown);
    return dropdown;
  }

  function renderResults(dropdown: HTMLElement, query: string) {
    if (!query || query.length < 1) { dropdown.innerHTML = ''; dropdown.style.display = 'none'; return; }
    const q = query.toLowerCase();
    const matches = toolsData.filter((item) => item.terms.includes(q)).slice(0, 12);
    if (!matches.length) { dropdown.innerHTML = ''; dropdown.style.display = 'none'; return; }
    dropdown.style.display = '';
    dropdown.innerHTML = matches.map((item) => `
      <a href="${item.href}" class="flex items-center justify-between gap-3 px-3 py-2.5 text-sm text-body hover:bg-canvas-soft hover:text-ink transition-colors" data-search-item>
        <span>${item.label}</span>
        <span class="shrink-0 text-xs text-muted">${item.category}</span>
      </a>
    `).join('');
  }

  function navigateToFirst(input: HTMLInputElement) {
    const dropdown = input.parentElement?.querySelector('[data-search-results]');
    const first = dropdown?.querySelector<HTMLAnchorElement>('a');
    first?.click();
  }

  document.addEventListener('input', (e) => {
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-tool-search]');
    if (!input) return;
    const dropdown = input.parentElement?.querySelector<HTMLElement>('[data-search-results]') ?? createSearchDropdown(input);
    renderResults(dropdown, input.value);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-tool-search]');
    if (!input) return;
    navigateToFirst(input);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const input = target.closest<HTMLInputElement>('[data-tool-search]');
    const item = target.closest<HTMLAnchorElement>('[data-search-item]');
    if (item || input) return;
    for (const dropdown of document.querySelectorAll<HTMLElement>('[data-search-results]')) {
      dropdown.innerHTML = '';
      dropdown.style.display = 'none';
    }
  });

  // Language switcher: each option's value is the URL of this page in that language.
  // The explicit choice is remembered so other pages can offer it; nothing ever redirects automatically.
  document.addEventListener('change', (e) => {
    const select = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-language-select]');
    if (!select) return;
    const option = select.selectedOptions[0];
    if (!option) return;
    try {
      window.localStorage.setItem('pixora-locale', option.dataset.locale ?? '');
      window.localStorage.removeItem('pixora-banner-dismissed');
    } catch {
      // Storage can be unavailable (private mode); switching still works.
    }
    location.href = option.value;
  });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
    if (!btn) return;
    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    if (isDark) {
      html.removeAttribute('data-theme');
      window.localStorage.setItem('freescreen-theme', 'light');
    } else {
      html.setAttribute('data-theme', 'dark');
      window.localStorage.setItem('freescreen-theme', 'dark');
    }
  });

  const menuToggle = document.querySelector('[data-mobile-menu-toggle]');
  const menuTemplate = document.querySelector<HTMLTemplateElement>('[data-mobile-menu]');
  if (menuToggle && menuTemplate) {
    menuToggle.addEventListener('click', () => {
      const content = menuTemplate.content.cloneNode(true) as DocumentFragment;
      const overlay = content.querySelector('[data-mobile-menu-overlay]')!;
      const backdrop = content.querySelector('[data-mobile-menu-backdrop]')!;
      const closeBtn = content.querySelector('[data-mobile-menu-close]')!;
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      const close = () => { overlay.remove(); document.body.style.overflow = ''; };
      backdrop.addEventListener('click', close);
      closeBtn.addEventListener('click', close);
    });
  }
</script>
