---
import type { Tool } from '../data/tools';
import { type Locale } from '../data/locales';
import { toolName } from '../data/translations';

type Props = {
  tool: Tool;
  locale: Locale;
};

const { tool, locale } = Astro.props;
const name = toolName(locale, tool);

// Production URL requirement: Always share https://pixorascreen.com${Astro.url.pathname}
const rawPathname = Astro.url.pathname;
const pathname = rawPathname.endsWith('/') ? rawPathname : `${rawPathname}/`;
const shareUrl = `https://pixorascreen.com${pathname}`;

// Share text requirement: "Try this free {Tool Name} on Pixora Screen"
const shareText = `Try this free ${name} on Pixora Screen`;

const encodedUrl = encodeURIComponent(shareUrl);
const encodedText = encodeURIComponent(shareText);

const sharePlatforms = [
  {
    name: 'Facebook',
    ariaLabel: `Share ${name} on Facebook`,
    url: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    bgHoverClass: 'hover:bg-[#1877F2] hover:text-white hover:border-[#1877F2]',
    iconSvg: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`
  },
  {
    name: 'WhatsApp',
    ariaLabel: `Share ${name} on WhatsApp`,
    url: `https://api.whatsapp.com/send?text=${encodeURIComponent(`${shareText} - ${shareUrl}`)}`,
    bgHoverClass: 'hover:bg-[#25D366] hover:text-white hover:border-[#25D366]',
    iconSvg: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>`
  },
  {
    name: 'X (Twitter)',
    ariaLabel: `Share ${name} on X (Twitter)`,
    url: `https://x.com/intent/post?text=${encodedText}&url=${encodedUrl}`,
    bgHoverClass: 'hover:bg-black hover:text-white hover:border-black dark:hover:bg-white dark:hover:text-black dark:hover:border-white',
    iconSvg: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`
  },
  {
    name: 'Telegram',
    ariaLabel: `Share ${name} on Telegram`,
    url: `https://t.me/share/url?url=${encodedUrl}&text=${encodedText}`,
    bgHoverClass: 'hover:bg-[#24A1DE] hover:text-white hover:border-[#24A1DE]',
    iconSvg: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.831-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`
  },
  {
    name: 'Reddit',
    ariaLabel: `Share ${name} on Reddit`,
    url: `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedText}`,
    bgHoverClass: 'hover:bg-[#FF4500] hover:text-white hover:border-[#FF4500]',
    iconSvg: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.196-.491.93 0 1.685.756 1.685 1.686 0 .604-.318 1.134-.798 1.433.023.192.036.385.036.58 0 2.986-3.468 5.412-7.744 5.412s-7.743-2.426-7.743-5.412c0-.192.012-.385.035-.574-.492-.296-.819-.83-.819-1.439 0-.93.755-1.686 1.685-1.686.467 0 .889.182 1.197.49 1.193-.855 2.846-1.417 4.667-1.489l.923-4.329 3.25.688a1.25 1.25 0 0 1 1.198-1.243zm-4.398 9.94c-.067.067-.176.067-.243 0-.756-.755-2.176-.755-2.93 0-.068.067-.177.067-.244 0-.067-.067-.067-.176 0-.243.89-.89 2.528-.89 3.417 0 .067.067.067.176 0 .243zm-3.56-2.18c-.467 0-.846.379-.846.846s.379.846.846.846.846-.379.846-.846-.379-.846-.846-.846zm5.908 0c-.467 0-.846.379-.846.846s.379.846.846.846.846-.379.846-.846-.379-.846-.846-.846z"/></svg>`
  },
  {
    name: 'LinkedIn',
    ariaLabel: `Share ${name} on LinkedIn`,
    url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    bgHoverClass: 'hover:bg-[#0A66C2] hover:text-white hover:border-[#0A66C2]',
    iconSvg: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>`
  }
];
---

<section class="border-b border-hairline py-6 bg-canvas-soft-2/40" aria-label="Share tool">
  <div class="site-shell flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div>
      <h3 class="text-sm font-semibold text-ink flex items-center gap-2">
        <svg class="w-4 h-4 text-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        Share this tool
      </h3>
      <p class="text-xs text-muted mt-0.5">Help others discover free fullscreen utilities & tools</p>
    </div>

    <div class="flex flex-wrap items-center gap-2 relative w-full md:w-auto">
      {sharePlatforms.map((platform) => (
        <a
          href={platform.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={platform.ariaLabel}
          title={platform.ariaLabel}
          class={`flex items-center gap-2 px-3 py-2 text-xs font-medium rounded-xl border border-hairline bg-canvas text-body shadow-xs transition-all duration-200 hover:scale-105 active:scale-95 ${platform.bgHoverClass}`}
        >
          <Fragment set:html={platform.iconSvg} />
          <span class="hidden sm:inline">{platform.name}</span>
        </a>
      ))}

      <!-- Copy Link Button -->
      <button
        id="copy-link-btn"
        data-share-url={shareUrl}
        aria-label="Copy link to clipboard"
        title="Copy link to clipboard"
        class="flex items-center gap-2 px-3.5 py-2 text-xs font-medium rounded-xl border border-hairline bg-canvas text-body shadow-xs transition-all duration-200 hover:scale-105 active:scale-95 hover:border-link hover:text-link cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
        <span class="hidden sm:inline">Copy Link</span>
      </button>

      <!-- Toast Notification for Copy Link -->
      <div
        id="copy-toast"
        role="status"
        aria-live="polite"
        class="hidden absolute right-0 -top-10 flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 text-white text-xs font-medium rounded-lg shadow-lg transition-all duration-200 pointer-events-none z-30"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>✓ Link copied!</span>
      </div>
    </div>
  </div>
</section>

<script>
  function initCopyLinkButton() {
    const copyBtn = document.getElementById('copy-link-btn');
    const toast = document.getElementById('copy-toast');
    let toastTimer: number | undefined;

    if (copyBtn && toast) {
      copyBtn.addEventListener('click', async () => {
        const shareUrl = copyBtn.getAttribute('data-share-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(shareUrl);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = shareUrl;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }

        // Show toast for 2 seconds
        toast.classList.remove('hidden');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.add('hidden');
        }, 2000);
      });
    }
  }

  initCopyLinkButton();
  document.addEventListener('astro:page-load', initCopyLinkButton);
</script>
